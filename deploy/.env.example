# Dominio público apuntando por DNS (A/AAAA) al servidor. No incluir https:// ni ruta.
DOMINIO=escala.ejemplo.com

# Acceso adicional a la aplicación. La contraseña nunca se guarda aquí en texto plano.
APP_USER=capital-humano
# Genera con: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TU_CONTRASENA_LARGA'
# Pega el resultado bcrypt/argon2 entre comillas simples. No subas deploy/.env a Git.
APP_PASSWORD_HASH=
